# Copy to .env and fill in real values. All services read config from
# runtime environment variables only — no secrets live in source code.

# --- Data Layer: Neon PostgreSQL ---
DATABASE_JDBC_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
DATABASE_USER=<user>
DATABASE_PASSWORD=<password>
POSTGRES_CONNECTION_STRING=Host=<neon-host>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require;Channel Binding=Require
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require&channel_binding=require

# --- Caching Layer: Upstash Redis (TCP + TLS) ---
REDIS_HOST=<name>.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=<token>
REDIS_SSL=true

# --- Messaging: CloudAMQP LavinMQ (AMQPS) ---
RABBITMQ_HOST=<name>.lmq.cloudamqp.com
RABBITMQ_PORT=5671
RABBITMQ_USERNAME=<user>
RABBITMQ_PASSWORD=<password>
RABBITMQ_VHOST=<vhost>
RABBITMQ_SSL=true

# --- Auth ---
JWT_SECRET=<random-64-hex-chars-min-32-bytes>
JWT_EXPIRATION_MINUTES=1440

# --- Frontend / CORS ---
NEXT_PUBLIC_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Service mesh (API -> ML proxy) ---
ML_SERVICE_URL=http://localhost:8000

# --- Worker ---
NOTIFICATION_WEBHOOK_URL=
